# Copy this file to .env and replace the placeholders with your own values.
# Never commit your .env file.

# Groq (required)
GROQ_API_KEY=your_groq_api_key
GROQ_MODEL=your_groq_model_id
GROQ_BASE_URL=https://api.groq.com
GROQ_TEMPERATURE=0

# Tavily web search (required)
TAVILY_API_KEY=your_tavily_api_key

# OpenWeather (for the weather tool)
OPENWEATHER_API_KEY=your_openweather_api_key

# LangSmith tracing (optional)
LANGSMITH_TRACING=false
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=your_langsmith_api_key
LANGSMITH_PROJECT=your_langsmith_project

# The Alpha Vantage key is not read from .env.
# See the placeholder in backend.py.
